# Copy to .env for local runs (node --env-file=.env server/index.js), or set
# these as secrets on your host. Only APP_PASSCODE is required.

# --- Required -------------------------------------------------------------
# The passcode you type once on your phone. Changing it signs every device out.
APP_PASSCODE=

# --- Research and writing (Claude) ---------------------------------------
# Without a key the app still works, publishing from the researched reserve.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_RESEARCH_EFFORT=high
# CLAUDE_MAX_SEARCHES=14
# CLAUDE_MAX_FETCHES=18

# --- The morning ----------------------------------------------------------
# Defaults; both can be changed in the app's Settings.
# DEFAULT_TIMEZONE=Africa/Nairobi
# DEFAULT_DELIVERY_TIME=08:00
# How long before delivery the research job starts (minutes).
# RESEARCH_LEAD_MINUTES=150
# How many researched, unused editions to keep in reserve.
# RESERVE_TARGET=3
# READER_NAME=Caspal

# --- Hosting --------------------------------------------------------------
# PORT=8080
# DATA_DIR=./data
# The app's public HTTPS address, used for links in WhatsApp messages.
PUBLIC_URL=https://your-app.example.com
# NODE_ENV=production
# For hosts that put idle apps to sleep: an external cron can POST
# /api/cron/tick with the header x-cron-secret: <this value>.
# CRON_SECRET=

# --- Push notifications ----------------------------------------------------
# Optional: generated automatically on first start and kept in the database.
# Set them here (npm run vapid) if you want them to survive a fresh database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- WhatsApp (optional) ----------------------------------------------------
# Official WhatsApp Business Platform (Cloud API). See README → WhatsApp.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=lift_me_up_morning
# WHATSAPP_TEMPLATE_LANG=en
# Order of the template's body variables: {{1}} = title, {{2}} = link.
# WHATSAPP_TEMPLATE_PARAMS=title,url
# WHATSAPP_GRAPH_VERSION=v23.0
# For honouring STOP replies through the webhook:
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
